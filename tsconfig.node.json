{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "drizzle.config.ts", "api", "server", "shared", "scripts/**/*.ts", "tests", "src/pdf/ajustar.ts"]
}

# Copiar a .env.local para desarrollo. En Vercel se cargan en el proyecto.
# Sin DATABASE_URL, el servidor local usa PGlite en .pglite/
DATABASE_URL=
# Sin token, las fotos quedan guardadas en el celular y la subida da error
BLOB_READ_WRITE_TOKEN=
APP_PASSWORD=carpas
AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

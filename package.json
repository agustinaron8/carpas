{
  "name": "carpas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "NODE_OPTIONS=--experimental-global-webcrypto tsx watch scripts/dev-api.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-global-webcrypto vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "browser-image-compression": "^2.0.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "jose": "^5.10.0",
    "lucide-react": "^1.77.0",
    "pdfmake": "^0.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^9.39.5",
    "@hono/node-server": "^2.1.11",
    "@types/node": "^20.19.43",
    "@types/pdfmake": "^0.2.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.8",
    "globals": "^15.15.0",
    "postcss": "^8.5.33",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
  }
}
